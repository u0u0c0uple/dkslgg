<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dkslgg.record.model.dao.MatchDao">
    <resultMap id="matchMap" type="MatchVo">
        <id property="id" column="id" />
        <result property="creation" column="creation" />
        <result property="duration" column="duration" />
        <collection property="participantList" resultMap="participantMap"/>
    </resultMap>
    <resultMap id="participantMap" type="ParticipantVo">
        <id property="puuid" column="puuid" />
        <result property="champId" column="champ_id" />
        <result property="champLevel" column="champ_level" />
        <result property="kill" column="kill" />
        <result property="death" column="death" />
        <result property="assist" column="assist" />
        <result property="teamId" column="team_id" />
        <collection property="account" resultMap="accountMap"/>
        <collection property="itemList" resultMap="participantItemMap"/>
    </resultMap>
    <resultMap id="accountMap" type="AccountVo">
        <id property="puuid" column="puuid" />
        <result property="gameName" column="game_name" />
        <result property="tagLine" column="tag_line" />
    </resultMap>
    <resultMap id="participantItemMap" type="ParticipantItemVo">
        <id property="itemOrder" column="item_order" />
        <result property="itemId" column="item_id" />
    </resultMap>

    <select id="selectMatch" parameterType="List" resultMap="matchMap">
        SELECT M.id, M.creation, M.duration, P.*, A.game_name, A.tag_line, PI.item_order, PI.item_id
        FROM `MATCH` M
            LEFT OUTER JOIN PARTICIPANT P ON M.id = P.match_id
            LEFT OUTER JOIN ACCOUNT A ON P.puuid = A.puuid
            LEFT OUTER JOIN PARTICIPANT_ITEM PI ON M.id = PI.match_id
        WHERE M.id IN (<foreach collection="idList" item="item" separator=","> #{item} </foreach>)
        ORDER BY creation DESC, team_id ASC, item_order ASC;
    </select>
    <insert id="insertMatch" parameterType="MatchVo">
        INSERT `MATCH` VALUES(#{id}, #{creation}, #{duration}, NOW(), NOW())
        ON DUPLICATE KEY UPDATE id = #{id}, creation = #{creation}, duration = #{duration}, updated_at = NOW();
    </insert>
    <insert id="insertParticipantList" parameterType="List">
        INSERT PARTICIPANT
        VALUES <foreach collection="participantList" item="item" separator=",">
        (#{item.matchId}, #{item.puuid}, #{item.champId}, #{item.champLevel}, #{item.kill}, #{item.death}, #{item.assist}, #{item.teamId})
    </foreach>;
    </insert>
    <insert id="insertParticipantItemList" parameterType="List">
        INSERT PARTICIPANT_ITEM(match_id, puuid, item_order, item_id)
        VALUES <foreach collection="participantItemList" item="item" separator=",">
        (#{item.matchId}, #{item.puuid}, #{item.itemOrder}, #{item.itemId})
    </foreach>;
    </insert>
</mapper>